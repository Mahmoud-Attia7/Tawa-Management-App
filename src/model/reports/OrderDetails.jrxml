	<subDataset name="cake items dataset" uuid="7e56a1d0-b063-4dc8-b75b-a2a621fb7a88">
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="TAWA DB connection"/>
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<parameter name="masterID" class="java.lang.String"/>
		<parameter name="department" class="java.lang.String"/>
		<queryString>
			<![CDATA[SELECT product.name,
	product.measure_unit,
	order1.`Quantity`,
	order1.shape,
	order3.width,
	order3.height,
	order3.length,
	order3.layer,
	order3.phrase,
	order3.stuff
FROM product
	JOIN order1 ON 
	 order1.`MasterID` = $P{masterID} 
	 AND order1.productID = product.ID
	 AND ($P{department} = 'all' OR product.department = $P{department}) 
	JOIN order3 ON 
	 order3.`productID` = order1.`ID` 
WHERE 
	 product.type = "cake"]]>
		</queryString>
