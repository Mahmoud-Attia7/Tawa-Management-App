		<parameter name="masterID" class="java.lang.String"/>
		<parameter name="department" class="java.lang.String"/>
		<queryString>
			<![CDATA[SELECT 
	product.name,
	product.measure_unit,
	order1.Quantity,
	order2.stuff_one,
	order2.stuff_two,
	order2.stuff_three,
	order2.stuff_four,
	order2.stuff_five 
FROM 
	product
JOIN 
	order1
	ON order1.MasterID =$P{masterID}
	AND order1.productID = product.ID
    AND ($P{department} = 'all' OR product.department = $P{department})
JOIN 
	order2 
	ON order2.productID = order1.ID 
WHERE 
	product.type ="stuff"]]>
